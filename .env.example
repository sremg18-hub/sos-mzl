# Drizzle (obligatoria — conéctala a tu Postgres de Coolify)
DATABASE_URL="postgres://sosmzl:password@host:5432/sosmzl"

# Credenciales del primer usuario administrador (seed)
ADMIN_EMAIL="admin@manizales.gov.co"
ADMIN_PASSWORD="cambiar-esta-clave"
INSPECTOR_EMAIL="inspector@manizales.gov.co"
INSPECTOR_PASSWORD="cambiar-esta-clave"

# Solo para desarrollo: siembra 40 inspecciones demo (1=si)
SEED_DEMO="0"

# Puerto HTTP (default 3000)
PORT=3000

# Detrás de proxy (Coolify/Traefik): protocolo/host reales del cliente
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
